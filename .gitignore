
# Private financial data: never commit raw exports or unreviewed redaction output
redacted-out/
private/
*.mbox
*.eml
sms-*.xml
*.jsonl
!fixtures/**/*.jsonl

# Secrets (values come from the installed environment, never the repo)
.env
.env.*
!.env.example
local.properties
*.jks
*.keystore
secrets/
credentials/
google-services.json
client_secret*.json

# Python bytecode (regenerated on every test run)
__pycache__/
*.pyc

# graphify: commit only the graph and its report (docs/TECHNICAL.md §2); the rest is
# per-machine cache, absolute paths and backups.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md

# Gradle / Android build output (regenerated; never committed)
.gradle/
build/
.kotlin/
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/
