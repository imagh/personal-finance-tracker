<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Personal Finance Tracker</string>
    <!-- Fail-closed screen when the data cannot be opened safely (DataUnavailableScreen): title, warning and code are shared; the explanation depends on the cause. -->
    <string name="data_unavailable_title">Your data can\'t be opened</string>
    <!-- The key-cause explanation for DataUnavailableScreen (DataUnavailableCause.KeyUnavailable); not a leftover of the data_unavailable_* rename. -->
    <string name="key_unavailable_explanation">Personal Finance Tracker could not get the key that protects your data on this phone, so it stopped instead of risking it. Your data has not been changed or deleted, and nothing was started over.</string>
    <!-- The identity-cause explanation for DataUnavailableScreen (DataUnavailableCause.IdentityCorrupt). -->
    <string name="identity_corrupt_explanation">Personal Finance Tracker found that the record of who uses this phone does not match the rest of your data, so it stopped instead of risking it. Your data has not been changed or deleted, and no new profile was created.</string>
    <string name="data_unavailable_warning">Do not clear the app\'s storage or uninstall it: that would erase your data for good. Restart the phone and try again. If this keeps happening, note the code below.</string>
    <string name="data_unavailable_code">Code: %1$s</string>
    <!-- Spoken labels for the ‹ › stepper in a Dashboard header. -->
    <string name="header_period_previous">Previous period</string>
    <string name="header_period_next">Next period</string>
    <!-- Spoken direction of an amount (MoneyText): said before the figure, so colour is never the only cue. -->
    <string name="money_expense">Expense</string>
    <string name="money_income">Income</string>
    <string name="money_transfer">Transfer</string>
    <string name="money_balance">Balance</string>
    <string name="money_balance_negative">Negative balance</string>
    <string name="money_budget_under">Under budget</string>
    <string name="money_budget_near_limit">Budget near its limit</string>
    <string name="money_budget_over">Over budget</string>
    <!-- Form blocks (NameField, EditFormScaffold). The limit in field_too_long comes from core's validation. -->
    <string name="field_required">Required</string>
    <string name="field_too_long">At most %1$d characters</string>
</resources>
