{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(secrets/**)",
      "Read(credentials/**)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(.git/**)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(secrets/**)",
      "Edit(credentials/**)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(secrets/**)",
      "Write(credentials/**)",
      "Bash(gh pr merge:*)",
      "Bash(git add -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(local.properties)",
      "Read(google-services.json)",
      "Read(client_secret*.json)",
      "Read(redacted-out/**)",
      "Read(private/**)",
      "Read(**/*.mbox)",
      "Read(**/*.eml)",
      "Read(sms-*.xml)",
      "Edit(local.properties)",
      "Write(local.properties)"
    ]
  }
}
